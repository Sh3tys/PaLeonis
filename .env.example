# Modèle du fichier .env : copier en .env puis adapter (le .env n'est jamais commité).

# Lues par docker-compose.yml pour créer le conteneur PostgreSQL et Adminer.
POSTGRES_DB=hosting
POSTGRES_USER=app
POSTGRES_PASSWORD=change_moi
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Lues par l'API (src/db.js et src/config/mongo.js). Doivent correspondre aux valeurs ci-dessus.
DATABASE_URL=postgresql://app:change_moi@localhost:5432/hosting
MONGO_URI=mongodb://127.0.0.1:27017/paleonis
